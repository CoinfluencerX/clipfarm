# Copy to .env and fill in yourself. Never paste these values into chat or commit them.

# Mode: dry-run | live   (live also requires LIVE=1)
MODE=dry-run
LIVE=0
DATA_DIR=data
LOG_LEVEL=info          # debug | info | warn | error

# Local tools (leave blank to use the ones on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Clip picking with Claude (optional; the built-in heuristic needs no key)
ANTHROPIC_API_KEY=

# Publishing: official APIs only. Fill in only the platforms you post to.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Or one posting service that holds approved apps for all of them
POSTING_API_KEY=

# Twitch (optional): list the VODs of a broadcaster who authorized your app
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Telegram review + alerts (your own bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
